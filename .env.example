# Browser-safe values from the shared Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# The entries below belong in Supabase Edge Function Secrets only.
# Never prefix these with NEXT_PUBLIC_ and never put real values in this file.
TOPUP_ROUTER_ENVIRONMENT=sandbox
TOPUP_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TOPUP_INTERNAL_ROUTER_KEY=generate-a-long-random-server-only-value
TOPUP_MONNIFY_SANDBOX_API_KEY=your-test-api-key
TOPUP_MONNIFY_SANDBOX_SECRET_KEY=your-test-secret-key
TOPUP_MONNIFY_SANDBOX_CONTRACT_CODE=your-test-contract-code
TOPUP_VTPASS_SANDBOX_API_KEY=your-sandbox-api-key
TOPUP_VTPASS_SANDBOX_PUBLIC_KEY=your-sandbox-public-key
TOPUP_VTPASS_SANDBOX_SECRET_KEY=your-sandbox-secret-key
TOPUP_PAYSTACK_ENABLED=false
TOPUP_OPAY_ENABLED=false
TOPUP_MONNIFY_BILLS_ENABLED=false
